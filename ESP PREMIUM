local function updateButtonVisual()
	if ESPEnabled then
		button.BackgroundColor3 = CONFIG.BeeYellow
		buttonGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, T.ButtonGradientTop),
			ColorSequenceKeypoint.new(1, T.ButtonGradientBottom),
		})
		buttonStroke.Color = CONFIG.BeeBlack
		statusLabel.Text = "ESP: ON  ✅"
		statusLabel.TextColor3 = T.TextColor
	else
		button.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
		buttonGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(130, 130, 130)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(50, 50, 50)),
		})
		buttonStroke.Color = Color3.fromRGB(30, 30, 30)
		statusLabel.Text = "ESP: OFF  ❌"
		statusLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
	end
end

updateButtonVisual()

button.MouseButton1Click:Connect(function()
	ESPEnabled = not ESPEnabled
	updateButtonVisual()
	refreshAll()
	print("Bee ESP: " .. (ESPEnabled and "ON" or "OFF"))
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.E then
		ESPEnabled = not ESPEnabled
		updateButtonVisual()
		refreshAll()
	end
end)

if ESPEnabled then
	task.wait(1)
	refreshAll()
end

