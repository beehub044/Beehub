----------------------------------------------------
-- ADVANCED FULL-BODY BEE ULTRA AURA EFFECT
----------------------------------------------------
local renderConnection = nil

local function removeFullBodyAura(character)
	if not character then return end
	if character:FindFirstChild("BeeAuraHighlight") then character.BeeAuraHighlight:Destroy() end
	if character:FindFirstChild("BeeHaloOuter") then character.BeeHaloOuter:Destroy() end
	if character:FindFirstChild("BeeHaloInner") then character.BeeHaloInner:Destroy() end
	if character:FindFirstChild("BeeOrbitFolder") then character.BeeOrbitFolder:Destroy() end

	local root = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
	if root then
		if root:FindFirstChild("BeeBodyParticles") then root.BeeBodyParticles:Destroy() end
		if root:FindFirstChild("BeeSelectionBox") then root.BeeSelectionBox:Destroy() end
		if root:FindFirstChild("BeeFloorLight") then root.BeeFloorLight:Destroy() end
	end

	if renderConnection then
		renderConnection:Disconnect()
		renderConnection = nil
	end
end

local function applyFullBodyAura(character)
	if not character then return end
	removeFullBodyAura(character)

	if avatarEffectActive then
		-- 1. FULL BODY GOLDEN HIGHLIGHT
		local highlight = Instance.new("Highlight")
		highlight.Name = "BeeAuraHighlight"
		highlight.FillColor = Color3.fromRGB(255, 200, 20)
		highlight.OutlineColor = Color3.fromRGB(255, 120, 0)
		highlight.FillTransparency = 0.5
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = character

		local root = character:WaitForChild("HumanoidRootPart", 5) or character:FindFirstChild("Torso")
		if root then
			-- 2. INNER NEON CORE SELECTION BOX
			local selBox = Instance.new("SelectionBox")
			selBox.Name = "BeeSelectionBox"
			selBox.Adornee = character
			selBox.Color3 = Color3.fromRGB(255, 235, 50)
			selBox.LineThickness = 0.05
			selBox.SurfaceTransparency = 0.8
			selBox.SurfaceColor3 = Color3.fromRGB(255, 180, 0)
			selBox.Parent = root

			-- 3. ASCENDING HONEY SPARKLE PARTICLES
			local particles = Instance.new("ParticleEmitter")
			particles.Name = "BeeBodyParticles"
			particles.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 240, 80)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 180, 0)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 100, 0))
			})
			particles.Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.5),
				NumberSequenceKeypoint.new(0.5, 0.8),
				NumberSequenceKeypoint.new(1, 0)
			})
			particles.Lifetime = NumberRange.new(1, 2.2)
			particles.Rate = 35
			particles.Speed = NumberRange.new(2, 4.5)
			particles.VelocitySpread = 180
			particles.LightEmission = 0.9
			particles.Transparency = NumberSequence.new(0.05, 1)
			particles.Parent = root

			-- 4. GROUND LIGHTING GLOW
			local floorLight = Instance.new("SurfaceLight")
			floorLight.Name = "BeeFloorLight"
			floorLight.Color = Color3.fromRGB(255, 200, 30)
			floorLight.Brightness = 3
			floorLight.Range = 12
			floorLight.Face = Enum.NormalId.Bottom
			floorLight.Parent = root
		end

		-- 5. ROTATING DUAL HALO RINGS
		local head = character:WaitForChild("Head", 5)
		if head then
			local createHalo = Instance.new("Part")
			createHalo.Name = "BeeHaloOuter"
			createHalo.Size = Vector3.new(2.8, 0.1, 2.8)
			createHalo.Material = Enum.Material.Neon
			createHalo.Color = Color3.fromRGB(255, 220, 0)
			createHalo.CanCollide = false
			createHalo.Massless = true

			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.FileMesh
			mesh.MeshId = "rbxassetid://3270017"
			mesh.Scale = Vector3.new(2.6, 2.6, 0.8)
			mesh.Parent = createHalo

			local weld1 = Instance.new("Weld")
			weld1.Part0 = head
			weld1.Part1 = createHalo
			weld1.C0 = CFrame.new(0, 1.8, 0) * CFrame.Angles(math.rad(90), 0, 0)
			weld1.Parent = createHalo
			createHalo.Parent = character

			local createHaloInner = createHalo:Clone()
			createHaloInner.Name = "BeeHaloInner"
			createHaloInner.Color = Color3.fromRGB(255, 140, 0)
			createHaloInner.SpecialMesh.Scale = Vector3.new(1.8, 1.8, 0.8)
			local weld2 = Instance.new("Weld")
			weld2.Part0 = head
			weld2.Part1 = createHaloInner
			weld2.C0 = CFrame.new(0, 2.1, 0) * CFrame.Angles(math.rad(90), 0, 0)
			weld2.Parent = createHaloInner
			createHaloInner.Parent = character

			-- 6. ORBITING BEE ENERGY ORBS
			local orbitFolder = Instance.new("Folder")
			orbitFolder.Name = "BeeOrbitFolder"
			orbitFolder.Parent = character

			local centerAtt = Instance.new("Attachment")
			centerAtt.Position = Vector3.new(0, -0.5, 0)
			centerAtt.Parent = root

			local orbAtts = {}
			local ORB_COUNT = 3
			for i = 1, ORB_COUNT do
				local att = Instance.new("Attachment")
				att.Parent = root

				local pEmitter = Instance.new("ParticleEmitter")
				pEmitter.Color = ColorSequence.new(Color3.fromRGB(255, 230, 40))
				pEmitter.Size = NumberSequence.new(0.3, 0)
				pEmitter.Lifetime = NumberRange.new(0.3, 0.6)
				pEmitter.Rate = 30
				pEmitter.Speed = NumberRange.new(0.5, 1)
				pEmitter.LightEmission = 1
				pEmitter.Parent = att

				table.insert(orbAtts, att)
			end

			-- ANIMATION LOOP FOR HALOS & ORBITING ORBS
			local angle = 0
			renderConnection = RunService.RenderStepped:Connect(function(dt)
				if head and head.Parent and root and root.Parent then
					angle = (angle + dt * 160) % 360
					
					-- Rotate Halos in opposite directions
					weld1.C0 = CFrame.new(0, 1.8, 0) * CFrame.Angles(math.rad(90 + math.sin(math.rad(angle)) * 10), math.rad(angle), 0)
					weld2.C0 = CFrame.new(0, 2.2, 0) * CFrame.Angles(math.rad(90 - math.sin(math.rad(angle)) * 10), math.rad(-angle * 1.5), 0)

					-- Orbiting Bee Orbs around Torso
					local radius = 3.2
					for i, att in ipairs(orbAtts) do
						local offsetAngle = math.rad(angle + (i * (360 / ORB_COUNT)))
						local x = math.cos(offsetAngle) * radius
						local z = math.sin(offsetAngle) * radius
						local y = math.sin(offsetAngle * 2) * 0.6
						att.Position = Vector3.new(x, y - 0.5, z)
					end
				else
					if renderConnection then renderConnection:Disconnect() end
				end
			end)
		end
	end
end

